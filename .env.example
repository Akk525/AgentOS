# AgentOS Environment Configuration
# Copy this file to .env and fill in the values you need.
# Never commit .env to version control.

# ── Provider API Keys ────────────────────────────────────────────────────────
# Required only when connecting to real providers (v2.0+ feature).
# Leave blank to use the simulated provider runtime.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Local Provider Config ────────────────────────────────────────────────────
# Ollama runs locally. Default base URL shown.

OLLAMA_BASE_URL=http://localhost:11434

# ── Runtime Settings ─────────────────────────────────────────────────────────
# Development server port (Vite default: 5173).

VITE_RUNTIME_PORT=5173

# Enable verbose runtime event logging in the browser console.
# Set to true when debugging runtime event flows.

VITE_AGENTOS_DEBUG=false

# ── Daemon Settings (v2.0+) ──────────────────────────────────────────────────
# These settings will apply when the Tauri daemon is implemented.
# No effect in the current browser-based prototype.

# AGENTOS_DAEMON_PORT=7620
# AGENTOS_MAX_SESSIONS=8
# AGENTOS_WORKSPACE_ROOT=~/agentos-workspaces
